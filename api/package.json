{
  "name": "game-backlog-api",
  "version": "1.0.0",
  "description": "API for GameBacklog Manager",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:ci": "eslint src/**/*.ts --quiet",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "//----- Sync Scripts -----    ": "",
    "sync:games": "ts-node src/services/steam-sync-service.ts",
    "sync:games:pics": "ts-node src/services/steam-pics-refresh-service.ts",
    "sync:players": "ts-node src/services/steam-player-count-sync-service.ts",
    "sync:enrich": "ts-node src/scripts/enrich-all-games.ts",
    "//----- Refresh Scripts -----    ": "",
    "refresh:games": "node dist/services/steam-pics-refresh-service.js",
    "//----- Recalculate Scripts -----    ": "",
    "recalculate:analytics": "node dist/scripts/recalculate-analytics.js",
    "recalculate:stats": "ts-node src/scripts/recalculate-stats.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/express-session": "^1.18.2",
    "@types/passport": "^1.0.17",
    "@types/passport-steam": "^1.0.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "node-appwrite": "^19.0.0",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18",
    "steam-user": "^5.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.10.4",
    "@types/steam-user": "^5.0.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "latest"
  }
}
