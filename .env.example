# ===========================================
# GameBacklog Environment Configuration
# ===========================================

# Server
PORT=6543

# URLs
# ---------------------------
# API_URL: Where your API server is accessible (used for Steam OAuth callback)
# FRONTEND_URL: Where your frontend is accessible (used for redirects after login)
#
# Local development:
API_URL=http://localhost:6543
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=.example.com
#
# Production example:
# API_URL=https://gameapi.yourdomain.com
# FRONTEND_URL=https://gamebacklog.yourdomain.com

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-secret-key-here

# Steam API Keys
# Get from: https://steamcommunity.com/dev/apikey
# Use multiple keys for parallel workers to avoid rate limits
STEAM_API_KEY=your-steam-api-key-here
STEAM_API_KEY_0=your-steam-api-key-0
STEAM_API_KEY_1=your-steam-api-key-1

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Worker Configuration (for distributed processing)
WORKER_ID=0
TOTAL_WORKERS=1
