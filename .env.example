# Server Configuration
PORT=6543

# Frontend URL for CORS
# In development: http://localhost:5173 or http://localhost:5174
# In production: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173

# Session Secret
# Generate a random secret for production: openssl rand -hex 32
SESSION_SECRET=your-secret-key-here

# Steam API Configuration
# Get your Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-api-key-here
STEAM_API_KEY_0=your-steam-api-key-0
STEAM_API_KEY_1=your-steam-api-key-1

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Appwrite Configuration (if used)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_GAMES_COLLECTION_ID=your-games-collection-id

# Worker Configuration (for distributed processing)
WORKER_ID=0
TOTAL_WORKERS=1
